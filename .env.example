# AI-Enhanced Domain Clustering Configuration
# Copy this file to .env and configure the values

# Enable/disable intelligent AI-based domain clustering
USE_INTELLIGENT_CLUSTERING=true

# Domain analysis cache configuration
DOMAIN_ANALYSIS_CACHE_TTL=604800000  # 7 days in milliseconds
DOMAIN_ANALYSIS_CACHE=true           # Enable/disable caching

# Cost management for AI analysis
MAX_DOMAIN_ANALYSIS_COST_PER_MONTH=50  # Maximum monthly cost in USD
DOMAIN_ANALYSIS_COST_ALERTS=true       # Enable cost alerts

# LLM Configuration for domain analysis (use existing LLM settings)
# LLM_PROVIDER=anthropic                # openai or anthropic
# LLM_MODEL=claude-3-sonnet-20240229   # Model for domain analysis
# ANTHROPIC_API_KEY=your_api_key_here   # Required for Anthropic
# OPENAI_API_KEY=your_api_key_here      # Required for OpenAI

# Other existing environment variables...
# AUTH_COOKIE_DOMAIN=.di-erdify.work
# AUTH_TRUSTED_ORIGINS=https://di-erdify.work,https://www.di-erdify.work
# RESEND_FROM_EMAIL=invitations@di-erdify.work
# VITE_APP_TITLE=ERDify - Database Design Made Simple
# VITE_APP_DESCRIPTION=AI-powered database design and visualization
# VITE_PRIMARY_COLOR=#2563eb